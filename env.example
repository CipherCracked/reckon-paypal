# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and never committed.

# PayPal REST API credentials (server-side only — never expose to the browser)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional. A catalog product id, once you have created that product and a
# billing plan for it at PayPal. With this set, the consent screen reads the
# price and term from the plan and says so; with it empty it computes from the
# terms published in `lib/catalog/` and says that instead. Leaving it empty does
# not mean nothing is created: starting a subscription creates its product and
# plan at PayPal on first use and reuses them (IPD 20).
PAYPAL_PRODUCT_HEADPHONES=

# The model that reads merchant copy and documents. Any provider that serves
# `POST {AI_BASE_URL}/chat/completions` with function calling will do — a hosted
# model, an aggregator, a proxy, or a daemon on this machine.
# AI_BASE_URL carries the version path as the provider publishes it, e.g.
# https://your-provider.example/v1 — we append only `/chat/completions`.
AI_BASE_URL=
AI_MODEL=
# Optional: omit it for a model running locally without auth.
AI_API_KEY=
# Optional, and off unless you ask for it: default | none | minimal | low | medium | high.
# Reading a document is copying, not reasoning, so a reasoning model can spend
# thousands of tokens thinking about a job that needs none — measured, one free
# model took 68.6 s for a 3.1 s answer, 95% of its output invisible. Unset (the
# default) means `none` and sends `{"enabled": false}`; `default` sends no such
# field at all, for a provider that would rather choose for itself.
# A graded value is a request, not an instruction: some models accept `low` and
# ignore it. `none` was honoured by the model this was measured on.
AI_REASONING_EFFORT=
# Rate limits and server errors are retried twice by the client, with backoff
# that honours Retry-After. Nothing to configure here.

# The live product catalogue behind /shop: real products, prices and retailer
# links. Server-side only. Without it the shop says it has nothing live to show
# and every other path keeps working.
CHANNEL3_API_KEY=

# Optional, and only for "What this store holds for you" (/account). At least 16
# characters, generated once and never shared: it signs the cookie that says
# which PayPal account is asking. Without it that page says it cannot check
# rather than running with an unsigned cookie, which would let anyone read
# anyone's records. Nothing else about the person is stored — no session table,
# no user row.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional, and only for a deployment behind something that rewrites Host.
# /account builds its redirects — PayPal's return URL included — from the address
# the browser used, so that a cookie set on that host is read back from it. Set
# this only when that address is not the one people type.
APP_ORIGIN=

# The origin registered as the app's return URL at PayPal. A sign-in always
# starts and finishes on this one, and a browser that arrived by another spelling
# of the same machine is moved here first — PayPal answers any other redirect_uri
# with "This action is not supported (invalid client_id or redirect_uri)", on its
# own site, where the person cannot be helped. Left empty, a browser on
# `localhost` is moved to `127.0.0.1` on the same port, which is the spelling the
# dashboard accepted for this app.
PAYPAL_RETURN_ORIGIN=

# Note for /account: PayPal's "Log in with PayPal" (Identity API) must be
# switched on for the REST app — Developer Dashboard → Apps & Credentials → your
# app → Log in with PayPal → Advanced Settings, with:
#   • the return URL — the origin you browse on plus /auth/paypal/callback,
#     character for character: localhost and 127.0.0.1 are separate registrations
#   • Email and PayPal account ID (payer ID) ticked. Without the payer id PayPal
#     signs the person in without saying which account, and the page refuses to
#     guess — see `lib/paypal/identity.ts`
#   • a privacy policy URL and user agreement URL (`https://example.com` is
#     accepted for testing)
# It is a dashboard setting; no code can turn it on.

