# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored and never committed.

# PayPal REST API credentials (server-side only — never expose to the browser)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional. A catalog product id, once you have created that product and a
# billing plan for it at PayPal. With these set, the consent screen reads the
# price and term from the plan and says so; with them empty it computes from
# the terms published in `lib/catalog/` and says that instead. Leaving them
# empty does not mean nothing is created: starting a subscription creates its
# product and plan at PayPal on first use and reuses them (IPD 20).
PAYPAL_PRODUCT_COFFEE_SUBSCRIPTION=
PAYPAL_PRODUCT_HEADPHONES=
PAYPAL_PRODUCT_MATTRESS=

# The model that reads merchant copy and documents. Any provider that serves
# `POST {AI_BASE_URL}/chat/completions` with function calling will do — a hosted
# model, an aggregator, a proxy, or a daemon on this machine.
# AI_BASE_URL carries the version path as the provider publishes it, e.g.
# https://your-provider.example/v1 — we append only `/chat/completions`.
AI_BASE_URL=
AI_MODEL=
# Optional: omit it for a model running locally without auth.
AI_API_KEY=
# Rate limits and server errors are retried twice by the client, with backoff
# that honours Retry-After. Nothing to configure here.
